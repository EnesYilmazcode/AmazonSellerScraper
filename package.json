{
  "name": "proscan-tests",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "zip": "node tools/build.mjs && node tools/zip.mjs",
    "test": "jest --verbose && npm run test:tools",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --verbose",
    "test:tools": "node --test --test-concurrency=1 \"tools/tests/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:contract": "node tools/contract.mjs",
    "test:coverage": "jest --coverage",
    "lock": "node tools/permission-lock.mjs && node tools/version-gate.mjs",
    "scan:secrets": "node tools/secret-scan.mjs",
    "check": "npm run build && npm run lock && npm run scan:secrets"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^20.0.3"
  },
  "dependencies": {
    "firebase": "^12.15.0"
  }
}
